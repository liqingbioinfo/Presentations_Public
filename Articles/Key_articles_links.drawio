        <mxCell id="6jMXHIdN_H4GYaneC3hk-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 16px;&quot;&gt;MISTy: Spatial modeling framework&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;multiple views&lt;/span&gt;&lt;/div&gt;" vertex="1">
