        <mxCell id="irOR0v8z4HFbtlijWc48-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b style=&quot;&quot;&gt;Modeling Long-Range Regulatory Context&lt;/b&gt;&lt;br&gt;&lt;br&gt;2020&amp;nbsp; — Basenji2&lt;br&gt;Cross-species regulatory sequence activity prediction, PLOS Computational Biology,&amp;nbsp;&lt;span style=&quot;color: rgb(27, 27, 27);&quot;&gt;PMID:&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;https://pubmed.ncbi.nlm.nih.gov/32687525/&quot; class=&quot;usa-link&quot; style=&quot;box-sizing: inherit; font-size-adjust: inherit; color: rgb(0, 94, 162);&quot;&gt;32687525&lt;/a&gt;&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-start=&quot;1195&quot; data-end=&quot;1216&quot;&gt;&lt;strong data-start=&quot;1195&quot; data-end=&quot;1214&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;Times New Roman&quot;&gt;2021 — Enformer&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;h1 class=&quot;c-article-title&quot; data-test=&quot;article-title&quot; data-article-title=&quot;&quot; style=&quot;margin: 0px 0px 16px; -webkit-font-smoothing: antialiased; letter-spacing: min(max(-0.0117156rem, 4vw), -0.0390625rem); line-height: 1.2; box-sizing: inherit; color: rgb(34, 34, 34);&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;Times New Roman&quot;&gt;Effective gene expression prediction from sequence by integrating long-range interactions.&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 16px; font-family: &amp;quot;Times New Roman&amp;quot;; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Nature methods.&amp;nbsp