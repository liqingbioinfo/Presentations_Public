          <mxGeometry height="30" width="152.6" x="327.4" y="620" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-55" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="M-M: Pearson correlation&lt;div&gt;M-G: beta effect from association (geneMAP)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Hypothesis: if two metabolies similar (function), their pearson correlation is greater than random.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Permutation test to generate r_12 under null hypothesis, then calcuate the P value for true r&#39;_12&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="360" x="200" y="690" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-57" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; caret-color: rgba(0, 0, 0, 0); white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;(a1, a2, ..., ap)&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; caret-color: rgba(0, 0, 0, 0); white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;a1: effect size from metabolites and genes association&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="31.5" width="190" x="200" y="628.5" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-58" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#223548;strokeColor=none;gradientDirection=east;fillColor=#5b738b;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="1" vertex="1">
          <mxGeometry height="30" width="30" x="280" y="410" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-59" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rotation=0;gradientColor=#223548;strokeColor=none;gradientDirection=east;fillColor=#5b738b;rounded=0;pointerEvents=0;fontFamily=Helvetica;fontSize=16;fontColor=#FFFFFF;spacingTop=4;spacingBottom=4;spacingLeft=4;spacingRight=4;points=[];fontStyle=1" value="2" vertex="1">
          <mxGeometry height="30" width="30" x="604" y="410" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;" value="rank top M-G" vertex="1">
          <mxGeometry height="30" width="180" x="540" y="450" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-61" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Rank top M-G, validate by MR and coloc. Then experimental validation&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="210" x="530" y="490" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-62" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="340" width="142.52" x="560" y="530" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-63" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;rotation=-90;" value="" vertex="1">
          <mxGeometry height="456.35" width="290.15" x="931.54" y="426.07" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-64" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="255.7" width="433.23" x="860" y="194.3" as="geometry" />
        </mxCell>
        <mxCell id="9UudMH3bKVM0lEAi0lWd-66" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&#xa;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;MR-JTI (Mendelian Randomization–Joint Tissue Imputation)&lt;/b&gt;&#xa;is a framework that extends multi-tissue TWAS into &lt;b&gt;causal inference&lt;/b&gt; by&#xa;jointly estimating the &lt;b&gt;causal effect of gene expression on a trait&lt;/b&gt; and &lt;b&gt;horizontal&#xa;pleiotropy&lt;/b&gt;, using only summary statistics.&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;What MR-JTI does?&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp; &lt;/span&gt;Does&#xa;genetically regulated expression of a gene causally affect a complex trait? &lt;/b&gt;It&#xa;integrates: &lt;b&gt;JTI&lt;/b&gt; (multi-tissue expression prediction); &lt;b&gt;Mendelian&#xa;randomization (MR)&lt;/b&gt;; &lt;b&gt;Explicit modeling of pleiotropy&lt;/b&gt; into a &lt;b&gt;single&#xa;unified framework&lt;/b&gt;.&lt;b&gt;&lt;/b&gt;&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;1. Explicit control of horizontal pleiotropy&lt;/b&gt;&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;Traditional TWAS (PrediXcan, JTI) implicitly assumes that&#xa;all SNPs used to predict expression affect the trait &lt;i&gt;only through that gene&lt;/i&gt;.&#xa;This assumption is often violated.&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;MR-JTI instead models SNP effects on the trait as:&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:&amp;quot;Aptos&amp;quot;,sans-serif;&#xa;mso-ascii-theme-font:minor-latin;mso-fareast-font-family:DengXian;mso-fareast-theme-font:&#xa;minor-fareast;mso-hansi-theme-font:minor-latin;mso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;&#xa;mso-bidi-theme-font:minor-bidi;mso-ansi-language:EN-CA;mso-fareast-language:&#xa;ZH-CN;mso-bidi-language:AR-SA&quot;&gt;&lt;img width=&quot;317&quot; height=&quot;47&quot; src=&quot;data:image/png;base64,&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;This allows MR-JTI to: Estimate the &lt;b&gt;gene–trait causal&#xa;effect&lt;/b&gt;; Quantify &lt;b&gt;heterogeneity due to pleiotropy&lt;/b&gt;; Reduce&#xa;false-positive causal claims common in TWAS&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;2. Multi-tissue causal inference with shared effects&lt;/b&gt;&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;MR-JTI leverages &lt;b&gt;multiple tissue-specific expression&#xa;models&lt;/b&gt;: SNP weights differ by tissue; Prediction accuracy differs by tissue;&#xa;&lt;b&gt;The causal effect is assumed to be shared across tissues&lt;/b&gt;&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;By jointly modeling tissues, MR-JTI: Increases statistical&#xa;power; Stabilizes causal estimates; Reduces tissue-specific noise&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;3. Fully summary-statistics based&lt;/b&gt;&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;MR-JTI requires only: GWAS summary statistics; Expression&#xa;prediction weights from JTI&lt;/p&gt;&#xa;&#xa;&lt;p class=&quot;MsoNormal&quot;&gt;No individual-level data are needed, making it: Scalable to&#xa;genome-wide analyses; Easily reproducible; Suitable for large consortia data&lt;/p&gt;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;" vertex="1">
          <mxGeometry height="30" width="60" x="1450" y="680" as="geometry" />
        </mxCell>
