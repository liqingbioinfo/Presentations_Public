        <mxCell id="jLvaAgckw38uRxlf_2XB-11" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="298.91" width="410.42" x="-410" y="1820" as="geometry" />
        </mxCell>
        <mxCell id="jLvaAgckw38uRxlf_2XB-13" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;rounded=0;strokeWidth=5;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint y="2140" as="sourcePoint" />
            <mxPoint x="-8" y="80" as="targetPoint" />
