        </mxCell>
        <UserObject label="https://www.nature.com/articles/s41591-025-04060-4" link="https://www.nature.com/articles/s41591-025-04060-4" id="JAFfz6rtNe68pfh0xoYF-3">
          <mxCell parent="1" style="text;whiteSpace=wrap;fontSize=28;" vertex="1">
