        <mxCell id="jLvaAgckw38uRxlf_2XB-2" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="&lt;h4 class=&quot;c-article__sub-heading c-article__sub-heading--small&quot; id=&quot;Sec6&quot; style=&quot;font-weight: 700; -webkit-font-smoothing: antialiased; line-height: 1.24; box-sizing: inherit; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; letter-spacing: -0.0117156rem; font-style: normal; color: rgb(34, 34, 34); margin: 24px 0px 8px; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Independent validation performance&lt;/font&gt;&lt;/h4&gt;" vertex="1">
          <mxGeometry height="79.99999999999999" width="300.609756097561" x="-505.1219512195122" y="975" as="geometry" />
