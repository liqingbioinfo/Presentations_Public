          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-660" y="1215" as="sourcePoint" />
            <mxPoint x="-660" y="745" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="f67gIQNVw1lp-HuG7de4-21" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" value="&lt;h3 class=&quot;c-article__sub-heading&quot; id=&quot;Sec4&quot; style=&quot;caret-color: rgba(0, 0, 0, 0); font-weight: 400; -webkit-font-smoothing: antialiased; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; letter-spacing: -0.0117156rem; font-size: 1.5rem; line-height: 1.24; box-sizing: inherit; color: rgb(34, 34, 34); margin: 24px 0px 8px;&quot;&gt;&lt;span&gt;HEX enables accurate prediction of protein expression from H&amp;amp;E images&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="90" width="760" x="-797.6" y="30" as="geometry" />
        </mxCell>
        <mxCell id="2DID-G2zERWf9IesuURK-16" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Harding, Palatino, serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;We assessed the model &lt;/span&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Harding, Palatino, serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;b&gt;accuracy &lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Harding, Palatino, serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;for protein expression on two independent datasets with CODEX and H&amp;amp;E-stained tissue sections for 372 tumor samples.&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Harding, Palatino, serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;span style=&quot;caret-color: rgba(0, 0, 0, 0);&quot;&gt;Two independent tissue microarray (TMA) cohorts—Stanford-TMA and tissue array TMA (TA-TMA)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="89.99999999999999" width="309.4512195121951" x="-642.1646341463414" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="2DID-G2zERWf9IesuURK-17" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Harding, Palatino, serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;span style=&quot;caret-color: rgba(0, 0, 0, 0);&quot;&gt;&lt;b&gt;Generalizability&lt;/b&gt;,&amp;nbsp;&lt;/span&gt;we externally validated HEX on a pan-cancer dataset containing 57-plex CODEX and matched H&amp;amp;E images across 206 tumor samples from 34 tissue types&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="238.69" x="-315" y="1055" as="geometry" />
