        <mxCell id="jLvaAgckw38uRxlf_2XB-19" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="640" width="781.32" x="-2517.9300000000003" y="55" as="geometry" />
        </mxCell>
        <mxCell id="jLvaAgckw38uRxlf_2XB-20" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="564.5" width="795.47" x="-2525" y="712.75" as="geometry" />
