          <mxGeometry height="800" width="628.44" x="3430" y="270" as="geometry" />
        </mxCell>
        <mxCell id="jLvaAgckw38uRxlf_2XB-35" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Text" vertex="1">
          <mxGeometry height="30" width="60" x="3710" y="360" as="geometry" />
        </mxCell>
        <mxCell id="jLvaAgckw38uRxlf_2XB-36" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;MICA, HEX, predicted the PD1 and PD-L1 response based on&amp;nbsp; H&amp;amp;E.&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Then compared with 148 response results to obtain AUC curves&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="500" x="3560" y="15" as="geometry" />
        </mxCell>
        <mxCell id="JAFfz6rtNe68pfh0xoYF-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Integrated gradients&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;span class=&quot;yt-core-attributed-string--link-inherit-color&quot; dir=&quot;auto&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; background: rgba(0, 0, 0, 0.05); font-family: Roboto, Arial, sans-serif; white-space-collapse: preserve; color: rgb(54, 54, 10);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Keras Code Example - Model interpretability with Integrated Gradients:&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;yt-core-attributed-string--link-inherit-color&quot; dir=&quot;auto&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; background: rgba(0, 0, 0, 0.05); font-family: Roboto, Arial, sans-serif; white-space-collapse: preserve; color: rgb(54, 54, 10);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;https://keras.io/examples/vision/integrated_gradients/ &lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;yt-core-attributed-string--link-inherit-color&quot; dir=&quot;auto&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; background: rgba(0, 0, 0, 0.05); font-family: Roboto, Arial, sans-serif; white-space-collapse: preserve; color: rgb(54, 54, 10);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;Visualizing the Impact of Feature Attribution Baselines: &lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;yt-core-attributed-string--link-inherit-color&quot; dir=&quot;auto&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; background: rgba(0, 0, 0, 0.05);&quot;&gt;&lt;font color=&quot;#36360a&quot; face=&quot;Roboto, Arial, sans-serif&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;https://distill.pub/2020/attribution-baselines/&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;yt-core-attributed-string--link-inherit-color&quot; dir=&quot;auto&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; background: rgba(0, 0, 0, 0.05); font-family: Roboto, Arial, sans-serif; white-space-collapse: preserve; color: rgb(54, 54, 10);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="680" x="2680" y="420" as="geometry" />
        </mxCell>
        <mxCell id="JAFfz6rtNe68pfh0xoYF-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
