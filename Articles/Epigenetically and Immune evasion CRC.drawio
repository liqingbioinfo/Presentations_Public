        <mxCell id="UnI0fS5W2R1EIqpq5tZH-42" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;" value="" vertex="1">
