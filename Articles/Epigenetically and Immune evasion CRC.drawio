        <mxCell id="FLlcXo33fteFZTflUlvy-40" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 class=&quot;c-article__sub-heading&quot; id=&quot;Sec7&quot; style=&quot;-webkit-font-smoothing: antialiased; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; letter-spacing: -0.0117156rem; font-size: 1.5rem; line-height: 1.24; box-sizing: inherit; font-style: normal; color: rgb(34, 34, 34); margin: 24px 0px 8px; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;u&gt;5. Prevalence and consequence of genetic immune escape&lt;/u&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="77" width="674" x="3524" y="1233" as="geometry" />
        </mxCell>
        <mxCell id="FLlcXo33fteFZTflUlvy-44" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/webp,;clipPath=inset(0% 0% 46.35% 0%);" value="" vertex="1">
          <mxGeometry height="408" width="567.5" x="3535" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="FLlcXo33fteFZTflUlvy-45" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;a href=&quot;https://www.frontiersin.org/journals/oncology/articles/10.3389/fonc.2020.588557/full&quot;&gt;URL&lt;/a&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="3555" y="1307" as="geometry" />
        </mxCell>
        <mxCell id="FLlcXo33fteFZTflUlvy-46" parent="1" style="text;whiteSpace=wrap;fontSize=20;" value="High-impact escape = early &amp; clonal, shared across entire tumor / multiple regions&#xa;Examples: &#xa;- B2M mutations (n=4) → ↓ expression (validated by RNA-seq); &#xa;- NLRC5, RFXAP mutations → ↓ MHC-I (HLA-A/B/C) expression; &#xa;- HLA LOH → clonal/near-clonal in most cases&#xa;→ Strong immune pressure → early selection of effective escape&#xa;&#xa;Low-impact escape = late &amp; subclonal, region-specific (single gland / subclone) → High intratumor variability&#xa;Examples:&#xa;- HLA gene SNVs, Other APG SNVs&#xa;→ Limited functional impact → weak selection" vertex="1">
          <mxGeometry height="407" width="507" x="4139" y="1337" as="geometry" />
        </mxCell>
        <mxCell id="FLlcXo33fteFZTflUlvy-47" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Helvetica&quot;&gt;Along CRC development&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;No escape in adenomas (except 1 advanced case); lower neoantigen burden in adenomas&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;→ Immune escape emerges early during CRC development&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Helvetica&quot;&gt;Immune selection link&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;* Escaped tumors:&amp;nbsp;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;- Lower neoantigen burden ;&amp;nbsp;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;- C524 and C548—cases with parallel evolution of HLA alterations—had biopsies with immune dNdS &amp;lt;1 (stringent immuno-editing)&amp;nbsp;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;suggesting past stringent immune surveillance could have led to selection for these HLA alterations ;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;* Partially escaped CRCs:&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;- intermediate overall proportional neoantigen burden, with immune dNdS values below 1, indicating immuno-editing&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Helvetica&quot;&gt;Tumor microenvironment (TME)&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Escaped / partially escaped tumors:&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;- ↑ PD-1+, VISTA+, CD163+ cells → T cell exhaustion, promote tumor growth&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;- ↑ fibroblasts + TGFβ signaling (TGFBR2 high expressed) → immune exclusion&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;Epigenetic escape:&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;- ↑ macrophages (CD68+) + memory T cells (CD45RO+), suggesting an association between SCAA-loss of antigen presentation and the TME.&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px; font-weight: normal;&quot; face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Helvetica&quot;&gt;Neoantigens are equally shared across tumor regions&lt;/font&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="1011.01" width="723" x="3535" y="1788" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
