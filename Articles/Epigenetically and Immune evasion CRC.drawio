        <mxCell id="UnI0fS5W2R1EIqpq5tZH-43" edge="1" parent="1" source="UnI0fS5W2R1EIqpq5tZH-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0;exitDx=0;exitDy=0;" target="UnI0fS5W2R1EIqpq5tZH-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="UnI0fS5W2R1EIqpq5tZH-44" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Their previous Nature paper show&lt;/font&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;ed t&lt;font face=&quot;Helvetica&quot;&gt;hat&amp;nbsp;&lt;b&gt;&lt;span style=&quot;color: rgb(34, 34, 34); background-color: rgb(255, 255, 255);&quot;&gt;somatic chromatin accessibility alterations (&lt;/span&gt;SCAAs)&lt;/b&gt; rewire TF binding → disrupt interferon signaling → Suggest epigenetic suppression of immune response&lt;br&gt;&lt;/font&gt;&lt;br&gt;Methods: examined the role of the epigenome in enabling im&lt;/font&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;mune escape by looking for &lt;b&gt;SCAAs &lt;/b&gt;associated with &lt;b&gt;APGs &lt;/b&gt;in 25 CRCs&lt;br&gt;&lt;br&gt;Results:&amp;nbsp;&lt;br&gt;45 SCAAs identified in APG promoters (25 CRCs)&lt;br&gt;62% (21/34) APGs affected&lt;br&gt;36% (9/25) patients with ≥1 APG disruption&lt;br&gt;42 (93%) of the SCAAs were losses of accessibility, significantly different than expected based on the genome-wide distribution of SCAAs&lt;br&gt;&lt;b&gt;None of the SCAAs co-occurred with somatic mutations in those genes&lt;/b&gt; (Fig. 2a).&amp;nbsp;&lt;br&gt;This exclusivity could indicate that mutations are more likely to be found in expressed genes or that SCAAs are an alternate route to antigen presentation disruption.&lt;/font&gt;" vertex="1">
          <mxGeometry height="370" width="1019" x="2047" y="510" as="geometry" />
        </mxCell>
        <mxCell id="UnI0fS5W2R1EIqpq5tZH-46" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Text" vertex="1">
          <mxGeometry height="30" width="60" x="3106" y="729" as="geometry" />
        </mxCell>
        <mxCell id="UnI0fS5W2R1EIqpq5tZH-49" edge="1" parent="1" source="UnI0fS5W2R1EIqpq5tZH-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="UnI0fS5W2R1EIqpq5tZH-44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="UnI0fS5W2R1EIqpq5tZH-47" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;SCAAs&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Detection: Compare ATAC-seq (tumor vs normal glands), correct for purity + copy number → Define SCAAs&amp;nbsp;&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;APG-gene: Keep SCAAs in promoter/enhancer regions, linked to antigen-presenting genes (APGs)&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Folder changes: Lossof SCAA: FC &amp;lt; −1; Gain of SCAA: FC &amp;gt; 1&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Significance: 200 random gene sets → expected distribution → Empirical P-value for enrichment&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="289" width="477" x="3079" y="516" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
